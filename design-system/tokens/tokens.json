{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ACME Corp Design Language v5.1.0 — design tokens (DTCG format). Light theme only: a cool Graphite base, an ink primary, Blue for interaction, Green/Amber/Red/Blue for status, and Signal Red as the brand signature. ACME Corp is a fictional company; this file is a test fixture for design tooling.",
  "color": {
    "$type": "color",
    "graphite": {
      "$description": "Graphite — the cool-neutral base (low chroma, a hint of blue): white canvas, ink text, hairline borders, and the ink primary action. Stop 950 is the dark ground of the deck bookend slides. Maps to --acme-gray-*.",
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F8F9FA"
      },
      "100": {
        "$value": "#F1F3F5"
      },
      "200": {
        "$value": "#E2E5E9"
      },
      "300": {
        "$value": "#C8CDD3"
      },
      "400": {
        "$value": "#838A94"
      },
      "500": {
        "$value": "#676E78"
      },
      "600": {
        "$value": "#525961"
      },
      "700": {
        "$value": "#3C424A"
      },
      "800": {
        "$value": "#272C32"
      },
      "900": {
        "$value": "#15181D"
      },
      "950": {
        "$value": "#0B0D10"
      }
    },
    "signal": {
      "$description": "Signal Red — the brand signature (wordmark mark; editorial marks in decks and reports) and, in product UI, danger. In an interface, red only ever means destructive or failed. Maps to --acme-red-*.",
      "50": {
        "$value": "#FFF0EE"
      },
      "100": {
        "$value": "#FFDEDB"
      },
      "200": {
        "$value": "#FFBDB6"
      },
      "300": {
        "$value": "#FB8D82"
      },
      "400": {
        "$value": "#F2594D"
      },
      "500": {
        "$value": "#E43227"
      },
      "600": {
        "$value": "#C91C15"
      },
      "700": {
        "$value": "#A91515"
      },
      "800": {
        "$value": "#881415"
      },
      "900": {
        "$value": "#641212"
      }
    },
    "blue": {
      "$description": "Blue — interaction: links, focus, checked controls, selected rows, the chart takeaway, and info status. Maps to --acme-blue-*.",
      "50": {
        "$value": "#EEF4FF"
      },
      "100": {
        "$value": "#DCE7FF"
      },
      "200": {
        "$value": "#BCD0FB"
      },
      "300": {
        "$value": "#86ACFA"
      },
      "500": {
        "$value": "#2F6BE4"
      },
      "600": {
        "$value": "#1F57C9"
      },
      "700": {
        "$value": "#1A47A6"
      },
      "800": {
        "$value": "#163A85"
      }
    },
    "green": {
      "$description": "Green — success status only. Maps to --acme-green-*.",
      "50": {
        "$value": "#EBF7F0"
      },
      "200": {
        "$value": "#B5E2C6"
      },
      "600": {
        "$value": "#17784D"
      },
      "700": {
        "$value": "#11643F"
      },
      "800": {
        "$value": "#0D5034"
      }
    },
    "amber": {
      "$description": "Amber — warning status only. Maps to --acme-amber-*.",
      "50": {
        "$value": "#FEF6E6"
      },
      "200": {
        "$value": "#F6D8A0"
      },
      "600": {
        "$value": "#A05A06"
      },
      "700": {
        "$value": "#834808"
      },
      "800": {
        "$value": "#6A3A0B"
      }
    },
    "semantic": {
      "$description": "Light theme only — the system ships no dark theme.",
      "light": {
        "canvas": {
          "$value": "{color.graphite.0}"
        },
        "surface": {
          "$value": "{color.graphite.50}"
        },
        "surface-hover": {
          "$value": "{color.graphite.100}"
        },
        "surface-raised": {
          "$value": "{color.graphite.0}"
        },
        "border": {
          "$value": "{color.graphite.200}",
          "$description": "Hairlines: card edges, dividers, table rows. Decorative."
        },
        "border-control": {
          "$value": "{color.graphite.300}",
          "$description": "Secondary-button edges. Decorative — the label identifies the control."
        },
        "border-strong": {
          "$value": "{color.graphite.400}",
          "$description": "Input and switch boundaries: >=3:1 against canvas, surface and raised (WCAG 1.4.11)."
        },
        "text": {
          "$value": "{color.graphite.900}"
        },
        "text-muted": {
          "$value": "{color.graphite.600}"
        },
        "text-subtle": {
          "$value": "{color.graphite.500}"
        },
        "primary": {
          "$value": "{color.graphite.900}",
          "$description": "Ink — the one solid action per view."
        },
        "primary-hover": {
          "$value": "{color.graphite.700}"
        },
        "primary-active": {
          "$value": "{color.graphite.800}"
        },
        "on-primary": {
          "$value": "{color.graphite.0}",
          "$description": "White label on the ink primary and red danger fills."
        },
        "accent": {
          "$value": "{color.signal.700}",
          "$description": "Brand editorial marks in decks and reports (kickers, rules, numerals, callouts). Never on a control."
        },
        "accent-soft": {
          "$value": "{color.signal.50}"
        },
        "selected": {
          "$value": "{color.blue.600}",
          "$description": "Checked controls and switch tracks (non-text, 3:1)."
        },
        "selected-soft": {
          "$value": "{color.blue.50}",
          "$description": "Selected table rows; text on it stays ink."
        },
        "link": {
          "$value": "{color.blue.700}"
        },
        "link-hover": {
          "$value": "{color.blue.800}"
        },
        "focus": {
          "$value": "{color.blue.600}",
          "$description": "Focus ring only; never restyled per component."
        },
        "success": {
          "$value": "{color.green.700}"
        },
        "success-soft": {
          "$value": "{color.green.50}"
        },
        "success-soft-text": {
          "$value": "{color.green.800}"
        },
        "success-border": {
          "$value": "{color.green.200}"
        },
        "warning": {
          "$value": "{color.amber.700}"
        },
        "warning-soft": {
          "$value": "{color.amber.50}"
        },
        "warning-soft-text": {
          "$value": "{color.amber.800}"
        },
        "warning-border": {
          "$value": "{color.amber.200}"
        },
        "danger": {
          "$value": "{color.signal.700}"
        },
        "danger-emphasis": {
          "$value": "{color.signal.600}"
        },
        "danger-emphasis-hover": {
          "$value": "{color.signal.700}"
        },
        "danger-soft": {
          "$value": "{color.signal.50}"
        },
        "danger-soft-text": {
          "$value": "{color.signal.700}"
        },
        "danger-border": {
          "$value": "{color.signal.200}"
        },
        "info": {
          "$value": "{color.blue.700}"
        },
        "info-soft": {
          "$value": "{color.blue.50}"
        },
        "info-soft-text": {
          "$value": "{color.blue.800}"
        },
        "info-border": {
          "$value": "{color.blue.200}"
        },
        "data": {
          "$value": "{color.graphite.400}"
        },
        "data-highlight": {
          "$value": "{color.blue.600}",
          "$description": "The single takeaway mark in a chart; always directly labelled."
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Helvetica Neue",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": "{font.family.sans}",
        "$description": "Alias of sans: one family, hierarchy from size, weight and tracking."
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "Cascadia Code",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular scale, 1rem base. Rendered px values assume 16px root.",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    },
    "tracking": {
      "$type": "dimension",
      "$description": "Letter-spacing. tight: h1/h2 and stats; snug: h3/h4, card titles, buttons; caps: uppercase kickers and labels.",
      "tight": {
        "$value": "-0.02em"
      },
      "snug": {
        "$value": "-0.011em"
      },
      "caps": {
        "$value": "0.06em"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Crisp, product-grade radii. Controls take md; cards lg; modals xl; badges sm. Pills (full) are reserved for switches and tab counts.",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "6px"
    },
    "lg": {
      "$value": "10px"
    },
    "xl": {
      "$value": "12px"
    },
    "full": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Soft, neutral, graphite-tinted elevation; hairline borders carry most of the separation.",
    "sm": {
      "$value": {
        "color": "#1018280D",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "md": {
      "$value": {
        "color": "#10182814",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      }
    },
    "lg": {
      "$value": {
        "color": "#1018282E",
        "offsetX": "0",
        "offsetY": "16px",
        "blur": "40px",
        "spread": "-8px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "100ms"
    },
    "base": {
      "$value": "150ms"
    },
    "slow": {
      "$value": "250ms"
    },
    "deliberate": {
      "$value": "400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Calm and precise; nothing overshoots.",
    "out": {
      "$value": [
        0.2,
        0.8,
        0.4,
        1
      ]
    },
    "in-out": {
      "$value": [
        0.45,
        0,
        0.25,
        1
      ]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    }
  }
}
