{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ACME Corp Design Language — design tokens (DTCG format). ACME Corp is a fictional company; this file is a test fixture for design tooling.",
  "color": {
    "$type": "color",
    "clay": {
      "$description": "Clay — the single highlight: primary action, links, selection, editorial marks, the wordmark mark, the chart takeaway. Maps to --acme-clay-*.",
      "50": {
        "$value": "#FAF0EB"
      },
      "100": {
        "$value": "#F3DDD0"
      },
      "200": {
        "$value": "#E9C3AF"
      },
      "300": {
        "$value": "#DDA588"
      },
      "400": {
        "$value": "#D18B6A"
      },
      "500": {
        "$value": "#CC785C"
      },
      "600": {
        "$value": "#94513B"
      },
      "700": {
        "$value": "#80432F"
      },
      "800": {
        "$value": "#6B3624"
      },
      "900": {
        "$value": "#552818"
      }
    },
    "oat": {
      "$description": "Oat — the warm neutral base. Paper canvas and ink text in light; surfaces in dark. Stop 400 is the shared control-boundary value used by border-strong in BOTH themes (>=3:1 either side).",
      "0": {
        "$value": "#FCFBF7"
      },
      "50": {
        "$value": "#F3F0E7"
      },
      "100": {
        "$value": "#E9E4D5"
      },
      "200": {
        "$value": "#C4BDA4"
      },
      "300": {
        "$value": "#A29B89"
      },
      "400": {
        "$value": "#7E7764"
      },
      "500": {
        "$value": "#5C5747"
      },
      "600": {
        "$value": "#554F41"
      },
      "700": {
        "$value": "#433F32"
      },
      "800": {
        "$value": "#2F2B21"
      },
      "900": {
        "$value": "#1E1B13"
      },
      "950": {
        "$value": "#100E08"
      }
    },
    "brick": {
      "$description": "Brick — danger only. A true red kept distinct from Clay's coral. Maps to --acme-red-*.",
      "50": {
        "$value": "#FBEEEC"
      },
      "300": {
        "$value": "#F3A395"
      },
      "400": {
        "$value": "#EF7361"
      },
      "500": {
        "$value": "#AC4334"
      },
      "600": {
        "$value": "#A82E1E"
      },
      "700": {
        "$value": "#97291B"
      },
      "800": {
        "$value": "#7A2116"
      }
    },
    "sky": {
      "$description": "Sky — info only. A muted slate blue. Maps to --acme-sky-*.",
      "50": {
        "$value": "#EDF1F4"
      },
      "300": {
        "$value": "#8DB0C9"
      },
      "500": {
        "$value": "#5C87A6"
      },
      "600": {
        "$value": "#3E6B8C"
      },
      "700": {
        "$value": "#305875"
      },
      "800": {
        "$value": "#274860"
      }
    },
    "semantic": {
      "light": {
        "canvas": {
          "$value": "{color.oat.50}"
        },
        "surface": {
          "$value": "{color.oat.100}"
        },
        "surface-raised": {
          "$value": "{color.oat.0}"
        },
        "border": {
          "$value": "{color.oat.200}"
        },
        "border-strong": {
          "$value": "{color.oat.400}"
        },
        "text": {
          "$value": "{color.oat.900}"
        },
        "text-muted": {
          "$value": "{color.oat.600}"
        },
        "text-subtle": {
          "$value": "{color.oat.500}"
        },
        "primary": {
          "$value": "{color.clay.600}"
        },
        "primary-hover": {
          "$value": "{color.clay.700}"
        },
        "primary-active": {
          "$value": "{color.clay.800}"
        },
        "on-primary": {
          "$value": "{color.oat.0}",
          "$description": "White on both themes — a fixed-hue clay fill needs no light/dark inversion."
        },
        "accent": {
          "$value": "{color.clay.700}"
        },
        "accent-soft": {
          "$value": "{color.clay.50}"
        },
        "selected": {
          "$value": "{color.clay.700}"
        },
        "selected-soft": {
          "$value": "{color.clay.50}"
        },
        "link": {
          "$value": "{color.clay.700}"
        },
        "link-hover": {
          "$value": "{color.clay.800}"
        },
        "focus": {
          "$value": "{color.clay.600}"
        },
        "success": {
          "$value": "{color.oat.600}"
        },
        "warning": {
          "$value": "{color.oat.600}"
        },
        "danger": {
          "$value": "{color.brick.700}"
        },
        "danger-emphasis": {
          "$value": "{color.brick.700}"
        },
        "info": {
          "$value": "{color.sky.700}"
        },
        "data": {
          "$value": "{color.oat.400}"
        },
        "data-highlight": {
          "$value": "{color.clay.600}"
        }
      },
      "dark": {
        "canvas": {
          "$value": "{color.oat.950}"
        },
        "surface": {
          "$value": "{color.oat.900}"
        },
        "surface-raised": {
          "$value": "{color.oat.800}"
        },
        "border": {
          "$value": "{color.oat.700}"
        },
        "border-strong": {
          "$value": "{color.oat.400}"
        },
        "text": {
          "$value": "{color.oat.100}"
        },
        "text-muted": {
          "$value": "{color.oat.300}"
        },
        "text-subtle": {
          "$value": "{color.oat.300}"
        },
        "primary": {
          "$value": "{color.clay.600}",
          "$description": "Fixed-hue clay fill in both themes; deepens on hover rather than inverting."
        },
        "primary-hover": {
          "$value": "{color.clay.700}"
        },
        "primary-active": {
          "$value": "{color.clay.800}"
        },
        "on-primary": {
          "$value": "{color.oat.0}"
        },
        "accent": {
          "$value": "{color.clay.300}",
          "$description": "Lighter than primary: accent marks are small text and must hold AA on raised surfaces."
        },
        "selected": {
          "$value": "{color.clay.300}"
        },
        "link": {
          "$value": "{color.clay.300}"
        },
        "link-hover": {
          "$value": "{color.clay.200}"
        },
        "focus": {
          "$value": "{color.clay.400}"
        },
        "success": {
          "$value": "{color.oat.300}"
        },
        "warning": {
          "$value": "{color.oat.300}"
        },
        "danger": {
          "$value": "{color.brick.400}"
        },
        "danger-emphasis": {
          "$value": "{color.brick.500}"
        },
        "info": {
          "$value": "{color.sky.300}"
        },
        "data": {
          "$value": "{color.oat.400}"
        },
        "data-highlight": {
          "$value": "{color.clay.300}"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Styrene B",
          "Inter",
          "Helvetica Neue",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Tiempos Headline",
          "Copernicus",
          "Georgia",
          "Times New Roman",
          "ui-serif",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "Cascadia Code",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular scale, 1rem base. Rendered px values assume 16px root.",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Restrained corporate radii. Controls and inputs take md; cards lg; modals xl. Pills (full) are reserved for badges and switches.",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "xl": {
      "$value": "16px"
    },
    "full": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Quiet, structural elevation; 1px borders carry most of the separation.",
    "sm": {
      "$value": {
        "color": "#0C0E120F",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "md": {
      "$value": {
        "color": "#0C0E121A",
        "offsetX": "0",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-2px"
      }
    },
    "lg": {
      "$value": {
        "color": "#0C0E1224",
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-6px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "100ms"
    },
    "base": {
      "$value": "150ms"
    },
    "slow": {
      "$value": "250ms"
    },
    "deliberate": {
      "$value": "400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Calm and precise; nothing overshoots.",
    "out": {
      "$value": [
        0.2,
        0.8,
        0.4,
        1
      ]
    },
    "in-out": {
      "$value": [
        0.45,
        0,
        0.25,
        1
      ]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    }
  }
}
