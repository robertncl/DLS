{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ACME Corp Design Language — design tokens (DTCG format). Light theme only: a near-neutral Stone base with one Signal Red highlight. ACME Corp is a fictional company; this file is a test fixture for design tooling.",
  "color": {
    "$type": "color",
    "signal": {
      "$description": "Signal Red — the single highlight: primary action, links, selection, focus, editorial marks, the wordmark mark, the chart takeaway. Maps to --acme-red-*.",
      "50": {
        "$value": "#FFF0EE"
      },
      "100": {
        "$value": "#FFDEDB"
      },
      "200": {
        "$value": "#FFBDB6"
      },
      "300": {
        "$value": "#FB8D82"
      },
      "400": {
        "$value": "#F2594D"
      },
      "500": {
        "$value": "#E43227"
      },
      "600": {
        "$value": "#C91C15"
      },
      "700": {
        "$value": "#A91515"
      },
      "800": {
        "$value": "#881415"
      },
      "900": {
        "$value": "#641212"
      }
    },
    "stone": {
      "$description": "Stone — the near-neutral base (chroma <= 0.015, a whisper of warmth): light canvas, dark ink text, quiet borders, neutral status. Same OKLab lightness steps as the v3 Slate ramp. Stop 950 is the dark ground of the deck bookend slides. Maps to --acme-gray-*.",
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F9F7F6"
      },
      "100": {
        "$value": "#F1EEEC"
      },
      "200": {
        "$value": "#CBC4C0"
      },
      "300": {
        "$value": "#B4ACA7"
      },
      "400": {
        "$value": "#847A76"
      },
      "500": {
        "$value": "#685F5A"
      },
      "600": {
        "$value": "#59504B"
      },
      "700": {
        "$value": "#453D38"
      },
      "800": {
        "$value": "#312A26"
      },
      "900": {
        "$value": "#1F1915"
      },
      "950": {
        "$value": "#15100D"
      }
    },
    "crimson": {
      "$description": "Crimson — danger only. Deeper and berry-leaning so a destructive action never reads as Signal Red. Maps to --acme-crimson-*.",
      "50": {
        "$value": "#FEEEF0"
      },
      "300": {
        "$value": "#EE8DA2"
      },
      "600": {
        "$value": "#AA2053"
      },
      "700": {
        "$value": "#8E1846"
      },
      "800": {
        "$value": "#731438"
      }
    },
    "blue": {
      "$description": "Blue — info only. Blue no longer means \"act\", so info takes the expected hue (the v3 Cobalt stops). Maps to --acme-blue-*.",
      "50": {
        "$value": "#EDF3FF"
      },
      "300": {
        "$value": "#86ACFA"
      },
      "500": {
        "$value": "#2F6BE4"
      },
      "600": {
        "$value": "#1F57C9"
      },
      "700": {
        "$value": "#1A47A6"
      },
      "800": {
        "$value": "#163A85"
      }
    },
    "semantic": {
      "$description": "Light theme only — the system ships no dark theme.",
      "light": {
        "canvas": {
          "$value": "{color.stone.50}"
        },
        "surface": {
          "$value": "{color.stone.100}"
        },
        "surface-raised": {
          "$value": "{color.stone.0}"
        },
        "border": {
          "$value": "{color.stone.200}"
        },
        "border-strong": {
          "$value": "{color.stone.400}",
          "$description": "Control boundaries: >=3:1 against canvas, surface and raised (WCAG 1.4.11)."
        },
        "text": {
          "$value": "{color.stone.900}"
        },
        "text-muted": {
          "$value": "{color.stone.600}"
        },
        "text-subtle": {
          "$value": "{color.stone.500}"
        },
        "primary": {
          "$value": "{color.signal.600}"
        },
        "primary-hover": {
          "$value": "{color.signal.700}"
        },
        "primary-active": {
          "$value": "{color.signal.800}"
        },
        "on-primary": {
          "$value": "{color.stone.0}",
          "$description": "White label on the Signal Red primary and Crimson danger fills."
        },
        "accent": {
          "$value": "{color.signal.700}"
        },
        "accent-soft": {
          "$value": "{color.signal.50}"
        },
        "selected": {
          "$value": "{color.signal.700}",
          "$description": "Rendered as text (tab label, sorted header, current nav item), so it holds the 4.5:1 text threshold."
        },
        "selected-soft": {
          "$value": "{color.signal.50}"
        },
        "link": {
          "$value": "{color.signal.700}"
        },
        "link-hover": {
          "$value": "{color.signal.800}"
        },
        "focus": {
          "$value": "{color.signal.600}"
        },
        "success": {
          "$value": "{color.stone.600}"
        },
        "success-soft": {
          "$value": "{color.stone.100}"
        },
        "success-soft-text": {
          "$value": "{color.stone.800}"
        },
        "warning": {
          "$value": "{color.stone.600}"
        },
        "warning-soft": {
          "$value": "{color.stone.100}"
        },
        "warning-soft-text": {
          "$value": "{color.stone.800}"
        },
        "danger": {
          "$value": "{color.crimson.700}"
        },
        "danger-emphasis": {
          "$value": "{color.crimson.700}"
        },
        "danger-emphasis-hover": {
          "$value": "{color.crimson.800}"
        },
        "danger-soft": {
          "$value": "{color.crimson.50}"
        },
        "danger-soft-text": {
          "$value": "{color.crimson.700}"
        },
        "info": {
          "$value": "{color.blue.700}"
        },
        "info-soft": {
          "$value": "{color.blue.50}"
        },
        "info-soft-text": {
          "$value": "{color.blue.800}"
        },
        "data": {
          "$value": "{color.stone.400}"
        },
        "data-highlight": {
          "$value": "{color.signal.600}"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Styrene B",
          "Inter",
          "Helvetica Neue",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Tiempos Headline",
          "Copernicus",
          "Source Serif 4",
          "Georgia",
          "Times New Roman",
          "ui-serif",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "Cascadia Code",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular scale, 1rem base. Rendered px values assume 16px root.",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Restrained corporate radii. Controls and inputs take md; cards lg; modals xl. Pills (full) are reserved for badges and switches.",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "xl": {
      "$value": "16px"
    },
    "full": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Quiet, structural, ink-tinted elevation; 1px borders carry most of the separation.",
    "sm": {
      "$value": {
        "color": "#1F19150F",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "md": {
      "$value": {
        "color": "#1F19151A",
        "offsetX": "0",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-2px"
      }
    },
    "lg": {
      "$value": {
        "color": "#1F191524",
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-6px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "100ms"
    },
    "base": {
      "$value": "150ms"
    },
    "slow": {
      "$value": "250ms"
    },
    "deliberate": {
      "$value": "400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Calm and precise; nothing overshoots.",
    "out": {
      "$value": [
        0.2,
        0.8,
        0.4,
        1
      ]
    },
    "in-out": {
      "$value": [
        0.45,
        0,
        0.25,
        1
      ]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    }
  }
}
