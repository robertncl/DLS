{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ACME Corp Design Language — design tokens (DTCG format). ACME Corp is a fictional company; this file is a test fixture for design tooling.",
  "color": {
    "$type": "color",
    "red": {
      "$description": "ACME Red — the brand scale. 600 is the anchor.",
      "50":  { "$value": "#FDF3F4" },
      "100": { "$value": "#FAE3E6" },
      "200": { "$value": "#F5C2C9" },
      "300": { "$value": "#EC93A0" },
      "400": { "$value": "#E05C70" },
      "500": { "$value": "#D22F4C" },
      "600": { "$value": "#C8102E" },
      "700": { "$value": "#A60D26" },
      "800": { "$value": "#8A0F23" },
      "900": { "$value": "#741122" },
      "950": { "$value": "#43060F" }
    },
    "graphite": {
      "$description": "Graphite — neutral scale for text, surfaces, and borders.",
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F8F9FA" },
      "100": { "$value": "#F1F3F5" },
      "200": { "$value": "#E4E7EB" },
      "300": { "$value": "#CDD2D9" },
      "400": { "$value": "#9AA1AC" },
      "500": { "$value": "#6C7480" },
      "600": { "$value": "#4E5560" },
      "700": { "$value": "#3A404A" },
      "800": { "$value": "#262B33" },
      "900": { "$value": "#16191F" },
      "950": { "$value": "#0C0E12" }
    },
    "blueprint": {
      "$description": "Blueprint Blue — informational and focus color.",
      "50":  { "$value": "#EFF4FE" },
      "100": { "$value": "#DEE9FD" },
      "200": { "$value": "#BCD2FA" },
      "300": { "$value": "#8FB0F5" },
      "400": { "$value": "#5F88EE" },
      "500": { "$value": "#3B82F6" },
      "600": { "$value": "#2563EB" },
      "700": { "$value": "#1D4ED8" }
    },
    "go": {
      "$description": "Go Green — success.",
      "50":  { "$value": "#F0FBF4" },
      "300": { "$value": "#7FD99A" },
      "400": { "$value": "#4CBB74" },
      "500": { "$value": "#22C55E" },
      "600": { "$value": "#15803D" },
      "700": { "$value": "#116932" }
    },
    "caution": {
      "$description": "Caution Amber — warnings.",
      "50":  { "$value": "#FEF8EB" },
      "300": { "$value": "#FCD34D" },
      "500": { "$value": "#F59E0B" },
      "700": { "$value": "#B45309" },
      "800": { "$value": "#92400E" }
    },
    "semantic": {
      "light": {
        "canvas":          { "$value": "{color.graphite.0}" },
        "surface":         { "$value": "{color.graphite.50}" },
        "surface-raised":  { "$value": "{color.graphite.0}" },
        "border":          { "$value": "{color.graphite.200}" },
        "border-strong":   { "$value": "{color.graphite.300}" },
        "text":            { "$value": "{color.graphite.900}" },
        "text-muted":      { "$value": "{color.graphite.600}" },
        "text-subtle":     { "$value": "{color.graphite.500}" },
        "primary":         { "$value": "{color.red.600}" },
        "primary-hover":   { "$value": "{color.red.700}" },
        "primary-active":  { "$value": "{color.red.800}" },
        "on-primary":      { "$value": "{color.graphite.0}" },
        "link":            { "$value": "{color.red.700}" },
        "focus":           { "$value": "{color.blueprint.500}" },
        "success":         { "$value": "{color.go.600}" },
        "warning":         { "$value": "{color.caution.700}" },
        "danger":          { "$value": "{color.red.700}" },
        "danger-emphasis": { "$value": "{color.red.700}" },
        "info":            { "$value": "{color.blueprint.600}" }
      },
      "dark": {
        "canvas":          { "$value": "{color.graphite.950}" },
        "surface":         { "$value": "{color.graphite.900}" },
        "surface-raised":  { "$value": "{color.graphite.800}" },
        "border":          { "$value": "{color.graphite.700}" },
        "border-strong":   { "$value": "{color.graphite.600}" },
        "text":            { "$value": "{color.graphite.100}" },
        "text-muted":      { "$value": "{color.graphite.400}" },
        "text-subtle":     { "$value": "{color.graphite.400}" },
        "primary":         { "$value": "{color.red.500}" },
        "primary-hover":   { "$value": "{color.red.400}" },
        "primary-active":  { "$value": "{color.red.600}" },
        "on-primary":      { "$value": "{color.graphite.0}" },
        "link":            { "$value": "{color.red.300}" },
        "focus":           { "$value": "{color.blueprint.400}" },
        "success":         { "$value": "{color.go.400}" },
        "warning":         { "$value": "{color.caution.500}" },
        "danger":          { "$value": "{color.red.400}" },
        "danger-emphasis": { "$value": "{color.red.500}" },
        "info":            { "$value": "{color.blueprint.400}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":    { "$value": ["Inter", "SF Pro Text", "Segoe UI", "system-ui", "sans-serif"] },
      "display": { "$value": ["Archivo", "Inter", "Segoe UI", "system-ui", "sans-serif"] },
      "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "Cascadia Code", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular scale, 1rem base. Rendered px values assume 16px root.",
      "xs":  { "$value": "0.75rem" },
      "sm":  { "$value": "0.875rem" },
      "md":  { "$value": "1rem" },
      "lg":  { "$value": "1.125rem" },
      "xl":  { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" },
      "5xl": { "$value": "3rem" }
    },
    "leading": {
      "$type": "number",
      "tight":   { "$value": 1.2 },
      "snug":    { "$value": 1.35 },
      "normal":  { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.25rem" },
    "6":  { "$value": "1.5rem" },
    "8":  { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "12px" },
    "xl":   { "$value": "16px" },
    "full": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "#0C0E1214", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" } },
    "md": { "$value": { "color": "#0C0E121F", "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
    "lg": { "$value": { "color": "#0C0E1229", "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "-8px" } }
  },
  "duration": {
    "$type": "duration",
    "fast":       { "$value": "100ms" },
    "base":       { "$value": "150ms" },
    "slow":       { "$value": "250ms" },
    "deliberate": { "$value": "400ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out":    { "$value": [0.2, 0.8, 0.4, 1] },
    "in-out": { "$value": [0.45, 0, 0.25, 1] }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
