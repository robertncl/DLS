{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ACME Corp Design Language — design tokens (DTCG format). Light theme only: a cool Slate base with one Cobalt highlight. ACME Corp is a fictional company; this file is a test fixture for design tooling.",
  "color": {
    "$type": "color",
    "cobalt": {
      "$description": "Cobalt — the single highlight: primary action, links, selection, focus, editorial marks, the wordmark mark, the chart takeaway. Maps to --acme-blue-*.",
      "50": {
        "$value": "#EDF3FF"
      },
      "100": {
        "$value": "#D9E6FF"
      },
      "200": {
        "$value": "#B6CDFE"
      },
      "300": {
        "$value": "#86ACFA"
      },
      "400": {
        "$value": "#5387F0"
      },
      "500": {
        "$value": "#2F6BE4"
      },
      "600": {
        "$value": "#1F57C9"
      },
      "700": {
        "$value": "#1A47A6"
      },
      "800": {
        "$value": "#163A85"
      },
      "900": {
        "$value": "#112C64"
      }
    },
    "slate": {
      "$description": "Slate — the blue-tinted neutral base: blue-white canvas, navy ink text, cool borders, neutral status. Stop 950 is the navy ground of the deck bookend slides. Maps to --acme-gray-*.",
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F5F8FC"
      },
      "100": {
        "$value": "#E9EFF7"
      },
      "200": {
        "$value": "#BAC7D8"
      },
      "300": {
        "$value": "#A0AFC3"
      },
      "400": {
        "$value": "#6E7E94"
      },
      "500": {
        "$value": "#526278"
      },
      "600": {
        "$value": "#44536A"
      },
      "700": {
        "$value": "#323F55"
      },
      "800": {
        "$value": "#212C3E"
      },
      "900": {
        "$value": "#111A2B"
      },
      "950": {
        "$value": "#0A111E"
      }
    },
    "red": {
      "$description": "Red — danger only. A true red, the one warm hue in the system. Maps to --acme-red-*.",
      "50": {
        "$value": "#FDEEEE"
      },
      "300": {
        "$value": "#F4A3A3"
      },
      "500": {
        "$value": "#D63A3A"
      },
      "600": {
        "$value": "#BF2A2A"
      },
      "700": {
        "$value": "#A42222"
      },
      "800": {
        "$value": "#871C1C"
      }
    },
    "teal": {
      "$description": "Teal — info only. Green-leaning so it never reads as Cobalt. Maps to --acme-teal-*.",
      "50": {
        "$value": "#E7F5F4"
      },
      "300": {
        "$value": "#7ACBC5"
      },
      "500": {
        "$value": "#1F8A84"
      },
      "600": {
        "$value": "#16716C"
      },
      "700": {
        "$value": "#105C58"
      },
      "800": {
        "$value": "#0C4845"
      }
    },
    "semantic": {
      "$description": "Light theme only — the system ships no dark theme.",
      "light": {
        "canvas": {
          "$value": "{color.slate.50}"
        },
        "surface": {
          "$value": "{color.slate.100}"
        },
        "surface-raised": {
          "$value": "{color.slate.0}"
        },
        "border": {
          "$value": "{color.slate.200}"
        },
        "border-strong": {
          "$value": "{color.slate.400}",
          "$description": "Control boundaries: >=3:1 against canvas, surface and raised (WCAG 1.4.11)."
        },
        "text": {
          "$value": "{color.slate.900}"
        },
        "text-muted": {
          "$value": "{color.slate.600}"
        },
        "text-subtle": {
          "$value": "{color.slate.500}"
        },
        "primary": {
          "$value": "{color.cobalt.600}"
        },
        "primary-hover": {
          "$value": "{color.cobalt.700}"
        },
        "primary-active": {
          "$value": "{color.cobalt.800}"
        },
        "on-primary": {
          "$value": "{color.slate.0}",
          "$description": "White label on the Cobalt primary and Red danger fills."
        },
        "accent": {
          "$value": "{color.cobalt.700}"
        },
        "accent-soft": {
          "$value": "{color.cobalt.50}"
        },
        "selected": {
          "$value": "{color.cobalt.700}",
          "$description": "Rendered as text (tab label, sorted header, current nav item), so it holds the 4.5:1 text threshold."
        },
        "selected-soft": {
          "$value": "{color.cobalt.50}"
        },
        "link": {
          "$value": "{color.cobalt.700}"
        },
        "link-hover": {
          "$value": "{color.cobalt.800}"
        },
        "focus": {
          "$value": "{color.cobalt.600}"
        },
        "success": {
          "$value": "{color.slate.600}"
        },
        "success-soft": {
          "$value": "{color.slate.100}"
        },
        "success-soft-text": {
          "$value": "{color.slate.800}"
        },
        "warning": {
          "$value": "{color.slate.600}"
        },
        "warning-soft": {
          "$value": "{color.slate.100}"
        },
        "warning-soft-text": {
          "$value": "{color.slate.800}"
        },
        "danger": {
          "$value": "{color.red.700}"
        },
        "danger-emphasis": {
          "$value": "{color.red.700}"
        },
        "danger-soft": {
          "$value": "{color.red.50}"
        },
        "danger-soft-text": {
          "$value": "{color.red.700}"
        },
        "info": {
          "$value": "{color.teal.700}"
        },
        "info-soft": {
          "$value": "{color.teal.50}"
        },
        "info-soft-text": {
          "$value": "{color.teal.800}"
        },
        "data": {
          "$value": "{color.slate.400}"
        },
        "data-highlight": {
          "$value": "{color.cobalt.600}"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Styrene B",
          "Inter",
          "Helvetica Neue",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Tiempos Headline",
          "Copernicus",
          "Georgia",
          "Times New Roman",
          "ui-serif",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "Cascadia Code",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 800
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular scale, 1rem base. Rendered px values assume 16px root.",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "20": {
      "$value": "5rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Restrained corporate radii. Controls and inputs take md; cards lg; modals xl. Pills (full) are reserved for badges and switches.",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "xl": {
      "$value": "16px"
    },
    "full": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Quiet, structural, navy-tinted elevation; 1px borders carry most of the separation.",
    "sm": {
      "$value": {
        "color": "#111A2B0F",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "md": {
      "$value": {
        "color": "#111A2B1A",
        "offsetX": "0",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-2px"
      }
    },
    "lg": {
      "$value": {
        "color": "#111A2B24",
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-6px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "100ms"
    },
    "base": {
      "$value": "150ms"
    },
    "slow": {
      "$value": "250ms"
    },
    "deliberate": {
      "$value": "400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Calm and precise; nothing overshoots.",
    "out": {
      "$value": [
        0.2,
        0.8,
        0.4,
        1
      ]
    },
    "in-out": {
      "$value": [
        0.45,
        0,
        0.25,
        1
      ]
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    }
  }
}
